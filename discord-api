function ex(e){
  const url=BASE+e.p.replace(/\{([^}]+)\}/g,(_,n)=>n.toUpperCase().replace(/\./g,"_"));
  const hdr=e.noauth?[]:["Authorization: Bot $BOT_TOKEN"];
  const bj=e.body?JSON.stringify(e.body):null;
  const curl=`curl -X ${e.m} "${url}" \\\n`+hdr.map(h=>`  -H "${h}" \\\n`).join("")+(bj?`  -H "Content-Type: application/json" \\\n  -d '${bj}'`:`  -H "Accept: application/json"`).replace(/ \\\n$/,"");
  const js=`const res = await fetch("${url}", {\n  method: "${e.m}",\n  headers: {\n${e.noauth?"":`    "Authorization": \`Bot \${process.env.BOT_TOKEN}\`,\n`}    "Content-Type": "application/json",\n  },${bj?`\n  body: JSON.stringify(${JSON.stringify(e.body)}),`:""}\n});\nif (res.status === 429) {\n  const { retry_after } = await res.json(); // seconds\n}\nconst data = res.status === 204 ? null : await res.json();`;
  const py=`import os, requests\n\nr = requests.request(\n    "${e.m}",\n    "${url}",\n${e.noauth?"":`    headers={"Authorization": f"Bot {os.environ['BOT_TOKEN']}"},\n`}${bj?`    json=${JSON.stringify(e.body)},\n`:""})\nr.raise_for_status()\nprint(r.json() if r.content else "ok")`;
  return {curl,js,py};
}
